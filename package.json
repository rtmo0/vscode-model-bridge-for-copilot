{
  "name": "antropic-for-copilot",
  "displayName": "Anthropic For Copilot - Use Claude with VS Code Agent",
  "description": "Use your signed-in Claude Code account as a VS Code Language Model Provider without an API key.",
  "version": "0.1.0",
  "publisher": "samarin-aa-aka-rtm00",
  "icon": "assets/anthropic-for-copilot.png",
  "license": "MIT",
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#5B3F93",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rtmo0/vscode-antropic-for-copilot.git"
  },
  "homepage": "https://github.com/rtmo0/vscode-antropic-for-copilot#readme",
  "bugs": {
    "url": "https://github.com/rtmo0/vscode-antropic-for-copilot/issues"
  },
  "qna": "https://github.com/rtmo0/vscode-antropic-for-copilot/discussions",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "anthropic",
    "claude",
    "claude-code",
    "copilot",
    "agent",
    "language-model"
  ],
  "activationEvents": [
    "onLanguageModelChatProvider:anthropic-for-copilot",
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "check": "tsc -p ./ --noEmit",
    "compile": "npm run check && node esbuild.mjs",
    "build": "node esbuild.mjs",
    "test:smoke": "node test/smokeClaudeProtocol.mjs && node test/smokeClaudeCli.mjs && node test/smokeClaudeSessionStore.mjs && node test/smokeAnthropicProviderOptions.mjs && node test/smokeClaudeUsageStatus.mjs",
    "package:vsix": "vsce package --no-dependencies",
    "package": "vsce package --no-dependencies",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.9.2"
  },
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "anthropic-for-copilot",
        "displayName": "Claude",
        "managementCommand": "anthropicForCopilot.manage"
      }
    ],
    "commands": [
      {
        "command": "anthropicForCopilot.manage",
        "title": "Manage",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.auth.signInWithClaudeCode",
        "title": "Sign in with Claude Code",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.auth.signInWithBrowser",
        "title": "Sign in with Browser",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.auth.showStatus",
        "title": "Show Sign-In Status",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.auth.signOut",
        "title": "Sign Out",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.refreshModels",
        "title": "Refresh Models",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.showUsage",
        "title": "Show Account Usage",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.installClaudeCode",
        "title": "Install Claude Code",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.openSettings",
        "title": "Open Settings",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.openLogs",
        "title": "Open Logs",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.doctor",
        "title": "Run Doctor",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.quickConfigure",
        "title": "Quick Configure Models",
        "category": "Anthropic for Copilot"
      },
      {
        "command": "anthropicForCopilot.updateClaudeCode",
        "title": "Update Claude Code",
        "category": "Anthropic for Copilot"
      }
    ],
    "configuration": {
      "title": "Anthropic for Copilot",
      "properties": {
        "anthropicForCopilot.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Path to the official Claude Code executable. With the default value, the extension also detects ~/.local/bin/claude. The CLI owns and stores the signed-in session."
        },
        "anthropicForCopilot.model": {
          "type": "string",
          "default": "default",
          "description": "Fallback Claude Code model alias used when a model identifier is unavailable."
        },
        "anthropicForCopilot.instructions": {
          "type": "string",
          "default": "You are a helpful coding assistant integrated with VS Code. Follow the user’s instructions and use only tools explicitly provided by VS Code.",
          "description": "Instructions appended to Claude Code for every VS Code Chat request."
        },
        "anthropicForCopilot.maxOutputTokens": {
          "type": "integer",
          "default": 128000,
          "minimum": 1,
          "description": "Output-token capacity advertised to VS Code. Claude Code and the selected model enforce the actual limit."
        },
        "anthropicForCopilot.defaultEffort": {
          "type": "string",
          "default": "high",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "Fastest responses with minimal extended thinking.",
            "Balanced speed and reasoning.",
            "Deeper reasoning for coding tasks.",
            "Very deep reasoning for difficult tasks.",
            "Maximum available reasoning effort."
          ],
          "description": "Default thinking effort shown in the model picker."
        },
        "anthropicForCopilot.defaultContextSize": {
          "type": "integer",
          "default": 1000000,
          "enum": [
            100000,
            200000,
            500000,
            1000000
          ],
          "enumItemLabels": [
            "100K",
            "200K",
            "500K",
            "1M"
          ],
          "description": "Default Claude Code auto-compact context window shown in the model picker."
        },
        "anthropicForCopilot.usageStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Claude 5-hour and 7-day account utilization in the status bar after usage data is received."
        },
        "anthropicForCopilot.enabledModels": {
          "type": "array",
          "default": [
            "default",
            "best",
            "fable",
            "sonnet",
            "opus",
            "haiku"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "default",
              "best",
              "fable",
              "sonnet",
              "opus",
              "haiku"
            ]
          },
          "description": "Claude model aliases shown in the VS Code model picker."
        },
        "anthropicForCopilot.requestTimeoutSeconds": {
          "type": "integer",
          "default": 600,
          "minimum": 30,
          "maximum": 3600,
          "description": "Maximum time for one Claude Code request before the process is terminated."
        },
        "anthropicForCopilot.sessionContinuation": {
          "type": "boolean",
          "default": false,
          "description": "Reuse compatible Claude Code sessions for incremental follow-ups. This improves prompt caching, but Claude Code persists those conversations in its local session history."
        }
      }
    }
  }
}
